{
  "schemaVersion": 1,
  "notes": [
    "IPSJ-TCE0301009 の図7に示された誤り混入ルール例を、このプロトタイプで扱える正規表現ルールへ落としたもの。",
    "paperRule は論文上のルール種別、operation は本実装での埋め込み方法を表す。"
  ],
  "rules": [
    {
      "id": "fig7a-relational-operator-drop-equals",
      "enabled": true,
      "paperRule": "置換の誤り混入ルール例",
      "title": "演算子の誤り",
      "description": "`<=` または `>=` の等号を落として境界条件を誤らせる。",
      "operation": "replace-capture",
      "pattern": "(<=|>=)",
      "group": 1,
      "variants": [
        { "from": "<=", "to": "<" },
        { "from": ">=", "to": ">" }
      ]
    },
    {
      "id": "semantic-for-upper-bound-minus-one",
      "enabled": true,
      "paperRule": "構造を保つ置換の誤り混入ルール",
      "title": "for文の終了条件を1つ手前にする誤り",
      "description": "`i < size` のような終了条件を `i < size - 1` にして、最後の要素を処理しないようにする。",
      "operation": "replace-capture",
      "pattern": "(for\\s*\\([^;]+;[^;]*<\\s*)([A-Za-z_][A-Za-z0-9_]*)(\\s*;)",
      "group": 0,
      "replacement": "$1$2 - 1$3"
    },
    {
      "id": "semantic-for-upper-bound-plus-one",
      "enabled": true,
      "category": "loop-boundary",
      "paperRule": "構造を保つ置換の誤り混入ルール",
      "title": "for文の終了条件を1つ先にする誤り",
      "description": "`i < size` のような終了条件を `i < size + 1` にして、余分な要素まで処理する。",
      "operation": "replace-capture",
      "pattern": "(for\\s*\\([^;]+;[^;]*<\\s*)([A-Za-z_][A-Za-z0-9_]*)(\\s*;)",
      "group": 0,
      "replacement": "$1$2 + 1$3"
    },
    {
      "id": "semantic-for-initial-zero-to-one",
      "enabled": true,
      "category": "loop-boundary",
      "paperRule": "構造を保つ置換の誤り混入ルール",
      "title": "for文の開始位置を1つ進める誤り",
      "description": "`for (i = 0; ...` を `for (i = 1; ...` にして、先頭要素を処理しないようにする。",
      "operation": "replace-capture",
      "pattern": "(for\\s*\\([^;=]+=[ \\t]*)(0)(\\s*;)",
      "group": 2,
      "replacement": "1"
    },
    {
      "id": "semantic-for-initial-one-to-zero",
      "enabled": true,
      "category": "loop-boundary",
      "paperRule": "構造を保つ置換の誤り混入ルール",
      "title": "for文の開始位置を1つ戻す誤り",
      "description": "`for (i = 1; ...` を `for (i = 0; ...` にして、余分な先頭要素を処理する。",
      "operation": "replace-capture",
      "pattern": "(for\\s*\\([^;=]+=[ \\t]*)(1)(\\s*;)",
      "group": 2,
      "replacement": "0"
    },
    {
      "id": "semantic-initial-zero-to-one",
      "enabled": true,
      "category": "initial-value",
      "paperRule": "構造を保つ置換の誤り混入ルール",
      "title": "初期値を0から1にする誤り",
      "description": "`sum = 0;` や `count = 0;` のような初期化を1にずらす。",
      "operation": "replace-capture",
      "pattern": "\\b(sum|count|total|ans|result|size|i|j|k)\\s*=\\s*(0)\\s*;",
      "group": 2,
      "replacement": "1"
    },
    {
      "id": "semantic-initial-one-to-zero",
      "enabled": true,
      "category": "initial-value",
      "paperRule": "構造を保つ置換の誤り混入ルール",
      "title": "初期値を1から0にする誤り",
      "description": "`count = 1;` のような初期化を0にずらす。",
      "operation": "replace-capture",
      "pattern": "\\b(sum|count|total|ans|result|size|i|j|k)\\s*=\\s*(1)\\s*;",
      "group": 2,
      "replacement": "0"
    },
    {
      "id": "semantic-comparison-operator-swap",
      "enabled": true,
      "category": "comparison-operator",
      "paperRule": "置換の誤り混入ルール例",
      "title": "比較演算子の取り違え",
      "description": "`if` や `while` の比較演算子を別の比較に変える。",
      "operation": "replace-capture",
      "pattern": "(==|!=|<=|>=|<|>)",
      "group": 1,
      "variants": [
        { "from": "==", "to": "!=" },
        { "from": "!=", "to": "==" },
        { "from": "<=", "to": ">" },
        { "from": ">=", "to": "<" },
        { "from": "<", "to": ">=" },
        { "from": ">", "to": "<=" }
      ]
    },
    {
      "id": "semantic-plus-equals-to-minus-equals",
      "enabled": true,
      "category": "arithmetic-operator",
      "paperRule": "置換の誤り混入ルール例",
      "title": "加算代入を減算代入にする誤り",
      "description": "`sum += x;` を `sum -= x;` にする。",
      "operation": "replace-capture",
      "pattern": "\\b[A-Za-z_][A-Za-z0-9_]*(?:\\s*\\[[^\\]]+\\])?\\s*(\\+=)\\s*[^;]+;",
      "group": 1,
      "replacement": "-="
    },
    {
      "id": "semantic-minus-equals-to-plus-equals",
      "enabled": true,
      "category": "arithmetic-operator",
      "paperRule": "置換の誤り混入ルール例",
      "title": "減算代入を加算代入にする誤り",
      "description": "`diff -= x;` を `diff += x;` にする。",
      "operation": "replace-capture",
      "pattern": "\\b[A-Za-z_][A-Za-z0-9_]*(?:\\s*\\[[^\\]]+\\])?\\s*(-=)\\s*[^;]+;",
      "group": 1,
      "replacement": "+="
    },
    {
      "id": "semantic-increment-to-plus-two",
      "enabled": true,
      "category": "arithmetic-operator",
      "paperRule": "置換の誤り混入ルール例",
      "title": "インクリメント量を増やす誤り",
      "description": "`count++` を `count += 2` にする。",
      "operation": "replace-capture",
      "pattern": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\+\\+)",
      "group": 0,
      "replacement": "$1 += 2"
    },
    {
      "id": "semantic-output-variable-swap",
      "enabled": true,
      "category": "output-variable",
      "paperRule": "構造を保つ置換の誤り混入ルール",
      "title": "出力変数の取り違え",
      "description": "`printf` に渡す変数を、同じプログラム内の別変数に取り違える。",
      "operation": "replace-with-variable",
      "pattern": "printf\\s*\\([^;\\n]*%[diufFeEgG][^;\\n]*,\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "group": 1
    },
    {
      "id": "semantic-array-index-plus-one",
      "enabled": true,
      "category": "array-index",
      "paperRule": "構造を保つ置換の誤り混入ルール",
      "title": "配列添字を1つ先にする誤り",
      "description": "`data[i]` を `data[i + 1]` にして、参照する要素をずらす。",
      "operation": "replace-capture",
      "pattern": "\\b[A-Za-z_][A-Za-z0-9_]*\\s*\\[\\s*(i|j|k|index|pos)\\s*\\]",
      "group": 1,
      "replacement": "$1 + 1"
    },
    {
      "id": "semantic-array-index-minus-one",
      "enabled": true,
      "category": "array-index",
      "paperRule": "構造を保つ置換の誤り混入ルール",
      "title": "配列添字を1つ手前にする誤り",
      "description": "`data[i]` を `data[i - 1]` にして、参照する要素をずらす。",
      "operation": "replace-capture",
      "pattern": "\\b[A-Za-z_][A-Za-z0-9_]*\\s*\\[\\s*(i|j|k|index|pos)\\s*\\]",
      "group": 1,
      "replacement": "$1 - 1"
    },
    {
      "id": "fig7c-scanf-missing-address",
      "enabled": true,
      "paperRule": "削除の誤り混入ルール例",
      "title": "scanf関数の実引数の&忘れ",
      "description": "`scanf` の変数実引数から `&` を削除する。",
      "operation": "delete-capture",
      "pattern": "scanf\\s*\\(\\s*\"[^\"]*\"\\s*,\\s*(&)(?=[A-Za-z_])",
      "group": 1,
      "replacement": ""
    },
    {
      "id": "fig7b-recursive-call-off-by-one",
      "enabled": true,
      "paperRule": "別解のある置換の誤り混入ルール例",
      "title": "関数の再帰呼出しの誤り",
      "description": "`return ... f(s - 1)` のような再帰呼出しを `s + 1` に変える。",
      "operation": "replace-capture",
      "pattern": "\\breturn[^;\\n]*\\([^;\\n()]*(-)\\s*1\\s*\\)",
      "group": 1,
      "replacement": "+"
    },
    {
      "id": "fig7d-struct-member-unnecessary-reference",
      "enabled": true,
      "paperRule": "挿入の誤り混入ルール例",
      "title": "構造体の不要なメンバ参照",
      "description": "`swap(a, b)` のような呼び出しに `.height` を挿入する。",
      "operation": "replace-capture",
      "pattern": "\\bswap\\s*\\(\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*,\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*\\)",
      "group": 0,
      "replacement": "swap($1.height, $2.height)"
    },
    {
      "id": "fig7e-for-initializer-move",
      "enabled": true,
      "paperRule": "移動の誤り混入ルール例",
      "title": "for文直前の初期化文の移動",
      "description": "`for` 文直前の単純な初期化文を、for本体の先頭へ移動する。",
      "operation": "replace-capture",
      "pattern": "((?:^|\\n)([ \\t]*)([A-Za-z_][A-Za-z0-9_]*\\s*=\\s*[^;\\n]+;)[ \\t]*\\n)(\\2for\\s*\\([^\\n]+\\)\\s*\\{)",
      "flags": "m",
      "group": 0,
      "replacement": "\n$4\n$2  $3"
    },
    {
      "id": "local-scanf-function-name-typo",
      "enabled": true,
      "paperRule": "図5プロトタイプ補助ルール",
      "title": "入力関数名の誤り",
      "description": "`scanf` を存在しない `scan` に置換する。",
      "operation": "replace-capture",
      "pattern": "\\bscanf\\b",
      "group": 0,
      "replacement": "scan"
    },
    {
      "id": "local-printf-comma-delete",
      "enabled": true,
      "paperRule": "図5プロトタイプ補助ルール",
      "title": "printf実引数の区切り忘れ",
      "description": "`printf` の書式文字列直後のカンマを削除する。",
      "operation": "delete-capture",
      "pattern": "printf\\s*\\(\\s*\"[^\"]*%[^\"]*\"\\s*(,)\\s*[A-Za-z_]",
      "group": 1,
      "replacement": ""
    }
  ]
}
